# Copy this file to .env and fill in real values. Never commit .env.

# --- Core ---
# Long, random secret. Required (must not be the default) when DEBUG=False.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
# Set to False in production. Turns off debug pages and enables security defaults.
DEBUG=True
# Comma-separated hostnames the site is served from (no scheme).
ALLOWED_HOSTS=127.0.0.1,localhost
# Comma-separated origins allowed for unsafe requests, including scheme.
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost

# --- Database ---
# Leave empty to use SQLite for local development.
# Set for production, for example:
# DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=

# --- Security (set to True in production; the site must be served over HTTPS) ---
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# --- Login throttling ---
# Failed attempts per IP+username before a cool-down, and the cool-down length.
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_SECONDS=300
